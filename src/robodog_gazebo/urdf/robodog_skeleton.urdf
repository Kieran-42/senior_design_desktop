<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robodog_skeleton">

    <!-- Tibia dimensions - can be changed here to update all tibias at once -->
    <xacro:property name="tibia_box_length" value="0.130"/>
    <xacro:property name="tibia_box_width" value="0.0254"/>
    <xacro:property name="tibia_box_height" value="0.0254"/>
    <xacro:property name="tibia_box_origin_x" value="0.065"/>
    <xacro:property name="tibia_box_origin_y" value="0.0"/>
    <xacro:property name="tibia_box_origin_z" value="0.0"/>
    
    <!-- Tibia inertial properties -->
    <xacro:property name="tibia_mass" value="0.1079"/>
    <xacro:property name="tibia_com_x" value="0.0"/>
    <xacro:property name="tibia_com_y" value="0.0"/>
    <xacro:property name="tibia_com_z" value="-0.1362"/>
    <xacro:property name="tibia_ixx" value="1.390E-04"/>
    <xacro:property name="tibia_ixy" value="0.0"/>
    <xacro:property name="tibia_ixz" value="0.0"/>
    <xacro:property name="tibia_iyy" value="1.379E-04"/>
    <xacro:property name="tibia_iyz" value="0.0"/>
    <xacro:property name="tibia_izz" value="1.069E-05"/>

    <!-- Tibia point of rotation: hip_tibia joint origin in hip_2 frame (meters). Change these to move where the tibia rotates. -->
    <xacro:property name="tibia_joint_origin_x" value="0.0"/>
    <xacro:property name="tibia_joint_origin_y" value="-0.055"/>
    <xacro:property name="tibia_joint_origin_z_right" value="0.0"/>
    <xacro:property name="tibia_joint_origin_z_left" value="0.0"/>

    <!-- Hip_1 (L1A) - dimensions, CoM and inertia from CAD; box centered at link (joint) origin -->
    <xacro:property name="hip_1_length" value="0.09903"/>
    <xacro:property name="hip_1_width" value="0.1263"/>
    <xacro:property name="hip_1_height" value="0.11"/>
    <xacro:property name="hip_1_origin_x" value="0.0"/>
    <xacro:property name="hip_1_origin_y" value="0.0"/>
    <xacro:property name="hip_1_origin_z" value="0.0"/>
    <xacro:property name="hip_1_rpy" value="0 1.5707963 1.5707963"/>
    <xacro:property name="hip_1_half_length" value="0.049515"/>
    <xacro:property name="hip_1_half_width" value="0.06315"/>
    <xacro:property name="hip_1_mass" value="0.1812"/>
    <xacro:property name="hip_1_com_x" value="${0.007169 + hip_1_half_width}"/>
    <xacro:property name="hip_1_com_y" value="0.04754"/>
    <xacro:property name="hip_1_com_z" value="0.0"/>
    <xacro:property name="hip_1_ixx" value="3.429E-04"/>
    <xacro:property name="hip_1_ixy" value="-5.447E-05"/>
    <xacro:property name="hip_1_ixz" value="-1.289E-18"/>
    <xacro:property name="hip_1_iyy" value="3.949E-04"/>
    <xacro:property name="hip_1_iyz" value="4.155E-18"/>
    <xacro:property name="hip_1_izz" value="5.339E-04"/>

    <!-- Hip_2 (L1B) - dimensions, CoM and inertia from CAD; box centered at link (joint) origin -->
    <xacro:property name="hip_2_length" value="0.07953"/>
    <xacro:property name="hip_2_width" value="0.11"/>
    <xacro:property name="hip_2_height" value="0.1173"/>
    <xacro:property name="hip_2_origin_x" value="0.0"/>
    <xacro:property name="hip_2_origin_y" value="0.0"/>
    <xacro:property name="hip_2_origin_z" value="0.0"/>
    <xacro:property name="hip_2_rpy" value="0 1.5707963 1.5707963"/>
    <xacro:property name="hip_2_half_length" value="0.039765"/>
    <xacro:property name="hip_2_mass" value="0.2326"/>
    <xacro:property name="hip_2_com_x" value="-0.03748"/>
    <xacro:property name="hip_2_com_y" value="0.0"/>
    <xacro:property name="hip_2_com_z" value="-4.460E-04"/>
    <xacro:property name="hip_2_ixx" value="4.965E-04"/>
    <xacro:property name="hip_2_ixy" value="0.0"/>
    <xacro:property name="hip_2_ixz" value="-2.810E-06"/>
    <xacro:property name="hip_2_iyy" value="5.157E-04"/>
    <xacro:property name="hip_2_iyz" value="-1.0E-12"/>
    <xacro:property name="hip_2_izz" value="4.560E-04"/>

    <!-- Paw dimensions - can be changed here to update all paws at once -->
    <xacro:property name="paw_box_length" value="0.02635"/>
    <xacro:property name="paw_box_width" value="0.093"/>
    <xacro:property name="paw_box_height" value="0.19"/>
    <xacro:property name="paw_box_origin_x" value="0.08"/>
    <xacro:property name="paw_box_origin_y" value="-0.0315"/>
    <xacro:property name="paw_box_origin_z" value="0.0"/>
    
    <!-- Paw (L3) orientation: 90 deg about y-axis (roll pitch yaw in rad) -->
    <xacro:property name="paw_rpy" value="0 1.5707963 0"/>
    
    <!-- Paw point of rotation: tibia_paw joint origin in tibia frame (meters). -->
    <xacro:property name="paw_joint_origin_x" value="0.1173"/>
    <xacro:property name="paw_joint_origin_y" value="0.0"/>
    <xacro:property name="paw_joint_origin_z" value="0.0"/>
    
    <!-- Paw inertial properties -->
    <xacro:property name="paw_mass" value="0.1342"/>
    <xacro:property name="paw_com_x" value="0.003169"/>
    <xacro:property name="paw_com_y" value="0.01116"/>
    <xacro:property name="paw_com_z" value="-0.08947"/>
    <xacro:property name="paw_ixx" value="3.878E-03"/>
    <xacro:property name="paw_ixy" value="-1.265E-05"/>
    <xacro:property name="paw_ixz" value="9.398E-06"/>
    <xacro:property name="paw_iyy" value="2.0E-03"/>
    <xacro:property name="paw_iyz" value="3.241E-05"/>
    <xacro:property name="paw_izz" value="2.0E-03"/>

    <!-- Wheel dimensions - can be changed here to update all wheels at once -->
    <xacro:property name="wheel_cylinder_radius" value="0.05"/>
    <xacro:property name="wheel_cylinder_length" value="0.065"/>
    <xacro:property name="wheel_origin_x" value="0.0"/>
    <xacro:property name="wheel_origin_y" value="0.0"/>
    <xacro:property name="wheel_origin_z" value="0.0"/>
    <!-- Wheel joint origin (paw frame to wheel): x along paw, z sign differs left/right -->
    <xacro:property name="wheel_joint_origin_x" value="0.175"/>
    <xacro:property name="wheel_joint_origin_y" value="-0.0315"/>
    <xacro:property name="wheel_joint_origin_z_right" value="0.045675"/>
    <xacro:property name="wheel_joint_origin_z_left" value="-0.045675"/>

    <material name="base_color">
        <color rgba="0.2 0.2 0.8 1.0"/>
    </material>

    <material name="hip_color">
        <color rgba="0.8 0.2 0.2 1.0"/>
    </material>

    <material name="tibia_color">
        <color rgba="0.2 0.8 0.2 1.0"/>
    </material>

    <material name="paw_color">
        <color rgba="0.8 0.8 0.2 1.0"/>
    </material>

    <material name="wheel_color">
        <color rgba="0.1 0.1 0.1 1.0"/>
    </material>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.8 0.1 0.1"/>    
            </geometry>
            <material name="base_color"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.8 0.1 0.1"/>
            </geometry>
        </collision>

        <visual>
            <origin xyz="0.05 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.4 0.1"/>    
            </geometry>
            <material name="base_color"/>
        </visual>
        <collision>
            <origin xyz="0.05 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.4 0.1"/>
            </geometry>
        </collision>

        <visual>
            <origin xyz="-0.35 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.4 0.1"/>    
            </geometry>
            <material name="base_color"/>
        </visual>
        <collision>
            <origin xyz="-0.35 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.4 0.1"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="13.6"/>
            <inertia
                ixx="0.1926667" ixy="0" ixz="0"
                iyy="0.7366667" iyz="0"
                izz="0.9066667"/>
        </inertial>
    </link>

    <!-- Gazebo properties for base_link -->
    <gazebo reference="base_link">
        <material>Gazebo/Blue</material>
        <mu1>0.2</mu1>
        <mu2>0.2</mu2>
        <selfCollide>false</selfCollide>
    </gazebo>

    <link name="rear_right_hip_1">
        <visual>
            <origin xyz="${hip_1_origin_x + hip_1_half_width} ${hip_1_origin_y} ${hip_1_origin_z}" rpy="${hip_1_rpy}"/>
            <geometry>
                <box size="${hip_1_length} ${hip_1_width} ${hip_1_height}"/>
            </geometry>
            <material name="hip_color"/>
        </visual>
        <collision>
            <origin xyz="${hip_1_origin_x + hip_1_half_width} ${hip_1_origin_y} ${hip_1_origin_z}" rpy="${hip_1_rpy}"/>
            <geometry>
                <box size="${hip_1_length} ${hip_1_width} ${hip_1_height}"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="${hip_1_com_x} ${hip_1_com_y} ${hip_1_com_z}" rpy="0 0 0"/>
            <mass value="${hip_1_mass}"/>
            <inertia
                ixx="${hip_1_ixx}" ixy="${hip_1_ixy}" ixz="${hip_1_ixz}"
                iyy="${hip_1_iyy}" iyz="${hip_1_iyz}"
                izz="${hip_1_izz}"/>
        </inertial>
    </link>

    <!-- Gazebo properties for rear_right_hip_1 -->
    <gazebo reference="rear_right_hip_1">
        <material>Gazebo/Red</material>
        <mu1>0.2</mu1>
        <mu2>0.2</mu2>
        <selfCollide>false</selfCollide>
    </gazebo>

    <joint name="rear_right_base_hip_joint" type="revolute">
        <origin xyz="-0.3 -0.15 0.0" rpy="1.5707963 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="rear_right_hip_1"/>
        <axis xyz="1 0 0"/>
        <limit lower="-3.1415926" upper="3.1415926" effort="1000" velocity="1.0"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- Gazebo properties for rear_right_base_hip_joint -->
    <gazebo reference="rear_right_base_hip_joint">
        <implicitSpringDamper>true</implicitSpringDamper>
        <selfCollide>false</selfCollide>
    </gazebo>

    <link name="rear_right_hip_2">
        <visual>
            <origin xyz="${hip_2_origin_x} ${hip_2_origin_y} ${hip_2_origin_z}" rpy="${hip_2_rpy}"/>
            <geometry>
                <box size="${hip_2_length} ${hip_2_width} ${hip_2_height}"/>
            </geometry>
            <material name="hip_color"/>
        </visual>
        <collision>
            <origin xyz="${hip_2_origin_x} ${hip_2_origin_y} ${hip_2_origin_z}" rpy="${hip_2_rpy}"/>
            <geometry>
                <box size="${hip_2_length} ${hip_2_width} ${hip_2_height}"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="${hip_2_com_x} ${hip_2_com_y} ${hip_2_com_z}" rpy="0 0 0"/>
            <mass value="${hip_2_mass}"/>
            <inertia
                ixx="${hip_2_ixx}" ixy="${hip_2_ixy}" ixz="${hip_2_ixz}"
                iyy="${hip_2_iyy}" iyz="${hip_2_iyz}"
                izz="${hip_2_izz}"/>
        </inertial>
    </link>

    <!-- Gazebo properties for rear_right_hip_2 -->
    <gazebo reference="rear_right_hip_2">
        <material>Gazebo/Red</material>
        <mu1>0.2</mu1>
        <mu2>0.2</mu2>
        <selfCollide>false</selfCollide>
    </gazebo>

    <joint name="rear_right_hip_1_hip_2_joint" type="revolute">
        <!-- origin xyz="${2 * hip_1_half_width} 0.0 0.0" rpy="0.0 0.0 0.0"/ -->
        <origin xyz="${hip_1_width-hip_2_width/2} -0.0073 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="rear_right_hip_1"/>
        <child link="rear_right_hip_2"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-3.1415926" upper="3.1415926" effort="1000" velocity="1.0"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="rear_right_tibia">
        <visual>
            <origin xyz="${tibia_box_origin_x} ${tibia_box_origin_y} ${tibia_box_origin_z}"/>
            <geometry>
                <box size="${tibia_box_length} ${tibia_box_width} ${tibia_box_height}"/>
            </geometry>
            <material name="tibia_color"/>
        </visual>
        <collision>
            <origin xyz="${tibia_box_origin_x} ${tibia_box_origin_y} ${tibia_box_origin_z}"/>
            <geometry>
                <box size="${tibia_box_length} ${tibia_box_width} ${tibia_box_height}"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="${tibia_com_x} ${tibia_com_y} ${tibia_com_z}" rpy="0 0 0"/>
            <mass value="${tibia_mass}"/>
            <inertia
                ixx="${tibia_ixx}" ixy="${tibia_ixy}" ixz="${tibia_ixz}"
                iyy="${tibia_iyy}" iyz="${tibia_iyz}"
                izz="${tibia_izz}"/>
        </inertial>
    </link>

    <!-- Gazebo properties for rear_right_tibia -->
    <gazebo reference="rear_right_tibia">
        <material>Gazebo/Green</material>
        <mu1>0.2</mu1>
        <mu2>0.2</mu2>
        <selfCollide>false</selfCollide>
    </gazebo>

    <joint name="rear_right_hip_tibia_joint" type="fixed">
        <origin xyz="${tibia_joint_origin_x} ${tibia_joint_origin_y} ${tibia_joint_origin_z_right}" rpy="0.0 0.0 -1.5707963"/>
        <parent link="rear_right_hip_2"/>
        <child link="rear_right_tibia"/>
    </joint>

    <!-- Gazebo properties for rear_right_hip_tibia_joint -->
    <gazebo reference="rear_right_hip_tibia_joint">
        <implicitSpringDamper>true</implicitSpringDamper>
        <selfCollide>false</selfCollide>
    </gazebo>

    <link name="rear_right_paw">
        <visual>
            <origin xyz="${paw_box_origin_x} ${paw_box_origin_y} ${paw_box_origin_z}" rpy="${paw_rpy}"/>
            <geometry>
                <box size="${paw_box_length} ${paw_box_width} ${paw_box_height}"/>
            </geometry>
            <material name="paw_color"/>
        </visual>
        <collision>
            <origin xyz="${paw_box_origin_x} ${paw_box_origin_y} ${paw_box_origin_z}" rpy="${paw_rpy}"/>
            <geometry>
                <box size="${paw_box_length} ${paw_box_width} ${paw_box_height}"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="${paw_com_x} ${paw_com_y} ${paw_com_z}" rpy="0 0 0"/>
            <mass value="${paw_mass}"/>
            <inertia
                ixx="${paw_ixx}" ixy="${paw_ixy}" ixz="${paw_ixz}"
                iyy="${paw_iyy}" iyz="${paw_iyz}"
                izz="${paw_izz}"/>
        </inertial>
    </link>

    <!-- Gazebo properties for rear_right_paw -->
    <gazebo reference="rear_right_paw">
        <material>Gazebo/Yellow</material>
        <mu1>0.2</mu1>
        <mu2>0.2</mu2>
        <selfCollide>false</selfCollide>
    </gazebo>

    <joint name="rear_right_tibia_paw_joint" type="revolute">
        <origin xyz="${paw_joint_origin_x} ${paw_joint_origin_y} ${paw_joint_origin_z}" rpy="0.0 0.0 0.0"/>  
        <parent link="rear_right_tibia"/>
        <child link="rear_right_paw"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-3.1415926" upper="3.1415926" effort="1000" velocity="1.0"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- Gazebo properties for rear_right_tibia_paw_joint -->
    <gazebo reference="rear_right_tibia_paw_joint">
        <implicitSpringDamper>true</implicitSpringDamper>
        <selfCollide>false</selfCollide>
    </gazebo>

    <link name="rear_right_wheel">
        <visual>
            <origin xyz="${wheel_origin_x} ${wheel_origin_y} ${wheel_origin_z}" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="${wheel_cylinder_radius}" length="${wheel_cylinder_length}"/>
            </geometry>
            <material name="wheel_color">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="${wheel_origin_x} ${wheel_origin_y} ${wheel_origin_z}" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="${wheel_cylinder_radius}" length="${wheel_cylinder_length}"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.22725"/>
            <inertia
                ixx="0.0002217" ixy="0" ixz="0"
                iyy="0.0002838" iyz="0"
                izz="0.0002217"/>
        </inertial>
    </link>

    <!-- Gazebo properties for rear_right_wheel -->
    <gazebo reference="rear_right_wheel">
        <material>Gazebo/Black</material>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <selfCollide>false</selfCollide>
    </gazebo>

    <joint name="rear_right_paw_wheel_joint" type="continuous">
        <origin xyz="${wheel_joint_origin_x} ${wheel_joint_origin_y} ${wheel_joint_origin_z_right}" rpy="0.0 0.0 0.0"/>
        <parent link="rear_right_paw"/>
        <child link="rear_right_wheel"/>
        <axis xyz="0.0 0.0 1.0"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- Gazebo properties for rear_right_paw_wheel_joint -->
    <gazebo reference="rear_right_paw_wheel_joint">
        <implicitSpringDamper>true</implicitSpringDamper>
        <selfCollide>false</selfCollide>
    </gazebo>

    <link name="rear_left_hip_1">
        <visual>
            <origin xyz="${hip_1_origin_x + hip_1_half_width} ${hip_1_origin_y} ${hip_1_origin_z}" rpy="${hip_1_rpy}"/>
            <geometry>
                <box size="${hip_1_length} ${hip_1_width} ${hip_1_height}"/>
            </geometry>
            <material name="hip_color"/>
        </visual>
        <collision>
            <origin xyz="${hip_1_origin_x + hip_1_half_width} ${hip_1_origin_y} ${hip_1_origin_z}" rpy="${hip_1_rpy}"/>
            <geometry>
                <box size="${hip_1_length} ${hip_1_width} ${hip_1_height}"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="${hip_1_com_x} ${hip_1_com_y} ${hip_1_com_z}" rpy="0 0 0"/>
            <mass value="${hip_1_mass}"/>
            <inertia
                ixx="${hip_1_ixx}" ixy="${hip_1_ixy}" ixz="${hip_1_ixz}"
                iyy="${hip_1_iyy}" iyz="${hip_1_iyz}"
                izz="${hip_1_izz}"/>
        </inertial>
    </link>

    <!-- Gazebo properties for rear_left_hip_1 -->
    <gazebo reference="rear_left_hip_1">
        <material>Gazebo/Red</material>
        <mu1>0.2</mu1>
        <mu2>0.2</mu2>
        <selfCollide>false</selfCollide>
    </gazebo>

    <joint name="rear_left_base_hip_joint" type="revolute">
        <origin xyz="-0.3 0.15 0.0" rpy="1.5707963 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="rear_left_hip_1"/>
        <axis xyz="1 0 0"/>
        <limit lower="-3.1415926" upper="3.1415926" effort="1000" velocity="1.0"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- Gazebo properties for rear_left_base_hip_joint -->
    <gazebo reference="rear_left_base_hip_joint">
        <implicitSpringDamper>true</implicitSpringDamper>
        <selfCollide>false</selfCollide>
    </gazebo>

    <link name="rear_left_hip_2">
        <visual>
            <origin xyz="${hip_2_origin_x} ${hip_2_origin_y} ${hip_2_origin_z}" rpy="${hip_2_rpy}"/>
            <geometry>
                <box size="${hip_2_length} ${hip_2_width} ${hip_2_height}"/>
            </geometry>
            <material name="hip_color"/>
        </visual>
        <collision>
            <origin xyz="${hip_2_origin_x} ${hip_2_origin_y} ${hip_2_origin_z}" rpy="${hip_2_rpy}"/>
            <geometry>
                <box size="${hip_2_length} ${hip_2_width} ${hip_2_height}"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="${hip_2_com_x} ${hip_2_com_y} ${hip_2_com_z}" rpy="0 0 0"/>
            <mass value="${hip_2_mass}"/>
            <inertia
                ixx="${hip_2_ixx}" ixy="${hip_2_ixy}" ixz="${hip_2_ixz}"
                iyy="${hip_2_iyy}" iyz="${hip_2_iyz}"
                izz="${hip_2_izz}"/>
        </inertial>
    </link>

    <!-- Gazebo properties for rear_left_hip_2 -->
    <gazebo reference="rear_left_hip_2">
        <material>Gazebo/Red</material>
        <mu1>0.2</mu1>
        <mu2>0.2</mu2>
        <selfCollide>false</selfCollide>
    </gazebo>

    <joint name="rear_left_hip_1_hip_2_joint" type="revolute">
        <!-- origin xyz="${2 * hip_1_half_width} 0.0 0.0" rpy="0.0 0.0 0.0"/ -->
        <origin xyz="${hip_1_width-hip_2_width/2} -0.0073 0.0" rpy="0.0 0.0 0.0"/>
