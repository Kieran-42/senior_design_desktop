                iyy="${paw_iyy}" iyz="${paw_iyz}"
                izz="${paw_izz}"/>
        </inertial>
    </link>

    <!-- Gazebo properties for front_left_paw -->
    <gazebo reference="front_left_paw">
        <material>Gazebo/Yellow</material>
        <mu1>0.2</mu1>
        <mu2>0.2</mu2>
        <selfCollide>false</selfCollide>
    </gazebo>

    <joint name="front_left_tibia_paw_joint" type="revolute">
        <origin xyz="${paw_joint_origin_x} ${paw_joint_origin_y} ${paw_joint_origin_z}" rpy="0.0 0.0 0.0"/>  
        <parent link="front_left_tibia"/>
        <child link="front_left_paw"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-3.1415926" upper="3.1415926" effort="1000" velocity="1.0"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- Gazebo properties for front_left_tibia_paw_joint -->
    <gazebo reference="front_left_tibia_paw_joint">
        <implicitSpringDamper>true</implicitSpringDamper>
        <selfCollide>false</selfCollide>
    </gazebo>

    <link name="front_left_wheel">
        <visual>
            <origin xyz="${wheel_origin_x} ${wheel_origin_y} ${wheel_origin_z}" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="${wheel_cylinder_radius}" length="${wheel_cylinder_length}"/>
            </geometry>
            <material name="wheel_color">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="${wheel_origin_x} ${wheel_origin_y} ${wheel_origin_z}" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="${wheel_cylinder_radius}" length="${wheel_cylinder_length}"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.22725"/>
            <inertia
                ixx="0.0002217" ixy="0" ixz="0"
                iyy="0.0002838" iyz="0"
                izz="0.0002217"/>
        </inertial>
    </link>

    <!-- Gazebo properties for front_left_wheel -->
    <gazebo reference="front_left_wheel">
        <material>Gazebo/Black</material>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <selfCollide>false</selfCollide>
    </gazebo>

    <joint name="front_left_paw_wheel_joint" type="continuous">
        <origin xyz="${wheel_joint_origin_x} ${wheel_joint_origin_y} ${wheel_joint_origin_z_left}" rpy="0.0 0.0 0.0"/>
        <parent link="front_left_paw"/>
        <child link="front_left_wheel"/>
        <axis xyz="0.0 0.0 1.0"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- Gazebo properties for front_left_paw_wheel_joint -->
    <gazebo reference="front_left_paw_wheel_joint">
        <implicitSpringDamper>true</implicitSpringDamper>
        <selfCollide>false</selfCollide>
    </gazebo>

    <!-- ROS 2 Control -->
    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        
        <!-- Joint interfaces for revolute joints -->
        <joint name="rear_right_base_hip_joint">
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        

        
        <joint name="rear_right_tibia_paw_joint">
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        
        <joint name="rear_left_base_hip_joint">
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        

        
        <joint name="rear_left_tibia_paw_joint">
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        
        <joint name="front_right_base_hip_joint">
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        

        
        <joint name="front_right_tibia_paw_joint">
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        
        <joint name="front_left_base_hip_joint">
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        

        
        <joint name="front_left_tibia_paw_joint">
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        
        <!-- Joint interfaces for continuous (wheel) joints -->
        <joint name="rear_right_paw_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        
        <joint name="rear_left_paw_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        
        <joint name="front_right_paw_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        
        <joint name="front_left_paw_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>

    <!-- Gazebo Plugin -->
    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find robodog_gazebo)/config/robodog_controllers.yaml</parameters>
        </plugin>
    </gazebo>

</robot>

