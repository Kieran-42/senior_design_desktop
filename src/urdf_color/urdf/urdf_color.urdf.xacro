<?xml version='1.0' encoding='utf-8'?>
<robot name="urdf_color" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="camera_name"   default="zedm" />
  <xacro:arg name="camera_model"  default="zedm" />
  <xacro:arg name="use_zed_localization" default="false" />
  <xacro:include filename="$(find zed_wrapper)/urdf/zed_macro.urdf.xacro" />
  <xacro:zed_camera name="$(arg camera_name)" model="$(arg camera_model)">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:zed_camera>
  
  <link name="base_footprint">
    <inertial>
      <mass value="0.0001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- Center the robot, ground it, and rotate -90 deg so X is forward -->
    <origin xyz="0.8858 0.8375 -0.7894" rpy="0 0 -1.5708" />
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0.837491492139643 -0.972075564965408 1.16249858131939" rpy="0 0 0" />
      <mass value="2.08362654858377" />
      <inertia ixx="0.0301960878113478" ixy="2.26221888530585E-18" ixz="-3.75267730633379E-10" iyy="0.00535275266306519" iyz="-2.31046346684137E-07" izz="0.0345230243527963" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://urdf_color/meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.0 0.0 1.0 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://urdf_color/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Add a joint to connect the ZED Camera to the robot -->
  <xacro:property name="use_zed_loc" value="$(arg use_zed_localization)" />

  <xacro:if value="${use_zed_loc == 'true' or use_zed_loc == 'True' or use_zed_loc == True}">
    <!-- ZED Localization -> The reference link is '$(arg camera_name)_camera_link' and 'base_link' is a child -->
    <joint name="$(arg camera_name)_joint" type="fixed">
      <parent link="$(arg camera_name)_camera_link"/>
      <child link="base_link"/>
      <origin xyz="0.6927 0.8375 -1.128" rpy="0 0 -1.5708" />
    </joint>
  </xacro:if>
  <xacro:unless value="${use_zed_loc == 'true' or use_zed_loc == 'True' or use_zed_loc == True}">
    <!-- NO ZED Localization -> '$(arg camera_name)_camera_link' is a child of 'base_link' -->
    <joint name="$(arg camera_name)_joint" type="fixed">
      <parent link="base_link"/>
      <child link="$(arg camera_name)_camera_link"/>
      <origin xyz="0.8375 -0.6927 1.128" rpy="0 0 1.5708" />
    </joint>
  </xacro:unless>
  <link name="front_right_hip">
    <inertial>
      <origin xyz="0.00596820108282792 -1.01124529860996E-08 0.0786652074201607" rpy="0 0 0" />
      <mass value="0.0682835197174219" />
      <inertia ixx="0.000107578043739037" ixy="2.86998710912503E-11" ixz="1.72663649384204E-05" iyy="0.000149860310883397" iyz="1.7495454172755E-11" izz="0.000119194202449452" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://urdf_color/meshes/front_right_hip.STL" />
      </geometry>
      <material name="">
        <color rgba="1.0 0.0 0.0 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://urdf_color/meshes/front_right_hip.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint_FR1" type="revolute">
    <origin xyz="0.938841492139661 -0.735851710589763 1.12887994406759" rpy="1.5707963267949 0 0" />
    <parent link="base_link" />
    <child link="front_right_hip" />
    <axis xyz="0 0 1" />
    <limit lower="-3.1415926" upper="3.1415926" effort="1000" velocity="1.0" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>
