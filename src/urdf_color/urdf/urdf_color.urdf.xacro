    <child link="back_left_upperleg" />
    <axis xyz="1 0 0" />
    <limit lower="-3.1415926" upper="3.1415926" effort="1000" velocity="1.0" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>
  <link name="back_left_lowerleg">
    <inertial>
      <origin xyz="-0.00313707084204307 -0.113584540455751 -0.0424962728174969" rpy="0 0 0" />
      <mass value="0.228830429344517" />
      <inertia ixx="0.000231457353091744" ixy="5.80698239946475E-09" ixz="-5.80606638404945E-09" iyy="0.000106373346469393" iyz="-1.13763375259938E-05" izz="0.000209650486510438" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://urdf_color/meshes/back_left_lowerleg.STL" />
      </geometry>
      <material name="">
        <color rgba="1.0 1.0 0.0 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://urdf_color/meshes/back_left_lowerleg.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint_BL3" type="revolute">
    <origin xyz="0 -0.179378082493594 0.0049999999981134" rpy="0 0 0" />
    <parent link="back_left_upperleg" />
    <child link="back_left_lowerleg" />
    <axis xyz="1 0 0" />
    <limit lower="-3.1415926" upper="3.1415926" effort="1000" velocity="1.0" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>
  <link name="back_left_wheel">
    <inertial>
      <origin xyz="-0.045029 -1.2767E-09 -1.6772E-09" rpy="0 0 0" />
      <mass value="0.43357" />
      <inertia ixx="0.00059182" ixy="-7.8341E-12" ixz="-1.0289E-11" iyy="0.00040382" iyz="-3.0242E-11" izz="0.00040382" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://urdf_color/meshes/back_left_wheel.STL" />
      </geometry>
      <material name="">
        <color rgba="0.1 0.1 0.1 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://urdf_color/meshes/back_left_wheel.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint_BL4" type="continuous">
    <origin xyz="-0.027541 -0.16 0" rpy="0 0 0" />
    <parent link="back_left_lowerleg" />
    <child link="back_left_wheel" />
    <axis xyz="1 0 0" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>
 
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      <param name="calculate_dynamics">true</param>
    </hardware>
 
    
    <joint name="joint_FR1">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="joint_FR2">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="joint_FR3">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="joint_FR4">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
 
    
    <joint name="joint_BR1">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="joint_BR2">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="joint_BR3">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="joint_BR4">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
 
    
    <joint name="joint_FL1">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="joint_FL2">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="joint_FL3">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="joint_FL4">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
 
    
    <joint name="joint_BL1">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="joint_BL2">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="joint_BL3">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="joint_BL4">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>
 
  
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find urdf_color)/config/robodog_controllers.yaml</parameters>
    </plugin>
  </gazebo>
 
  <gazebo reference="$(arg camera_name)_left_camera_frame">
    <sensor name="zed_camera" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.91986</horizontal_fov>
        <image>
          <width>640</width>
          <height>360</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>zed/zed_node/rgb/image_rect_color</topic>
      <gz_frame_id>$(arg camera_name)_left_camera_optical_frame</gz_frame_id>
    </sensor>
    <sensor name="zed_camera_raw" type="camera">
      <camera>
        <horizontal_fov>1.91986</horizontal_fov>
        <image>
          <width>640</width>
          <height>360</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <topic>zed/zed_node/rgb/image_raw_color</topic>
      <gz_frame_id>$(arg camera_name)_left_camera_optical_frame</gz_frame_id>
    </sensor>
  </gazebo>
 
  <gazebo reference="$(arg camera_name)_right_camera_frame">
    <sensor name="zed_camera_right" type="camera">
      <camera>
        <horizontal_fov>1.91986</horizontal_fov>
        <image>
          <width>640</width>
          <height>360</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>zed/zed_node/right/image_rect_color</topic>
      <gz_frame_id>$(arg camera_name)_right_camera_optical_frame</gz_frame_id>
    </sensor>
    <sensor name="zed_camera_right_raw" type="camera">
      <camera>
        <horizontal_fov>1.91986</horizontal_fov>
        <image>
          <width>640</width>
          <height>360</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <topic>zed/zed_node/right/image_raw_color</topic>
      <gz_frame_id>$(arg camera_name)_right_camera_optical_frame</gz_frame_id>
    </sensor>
  </gazebo>
 
  <gazebo reference="$(arg camera_name)_camera_center">
    <sensor name="zed_imu" type="imu">
      <imu>
        <angular_velocity>
          <x><noise type="none"/></x>
          <y><noise type="none"/></y>
          <z><noise type="none"/></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="none"/></x>
          <y><noise type="none"/></y>
          <z><noise type="none"/></z>
        </linear_acceleration>
      </imu>
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>zed/zed_node/imu/data</topic>
      <gz_frame_id>$(arg camera_name)_camera_center</gz_frame_id>
    </sensor>
  </gazebo>
 
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>zed/zed_node/joint_states</topic>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>zed/zed_node/odom</odom_topic>
      <tf_topic>zed/zed_node/tf</tf_topic>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_sensor_pose>true</publish_sensor_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_models>true</publish_nested_models>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>true</static_publisher>
      <static_update_frequency>1</static_update_frequency>
    </plugin>
  </gazebo>
 
</robot>